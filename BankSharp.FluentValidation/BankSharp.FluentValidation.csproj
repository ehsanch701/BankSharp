<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Target Frameworks: Multi-targeting .NET 8 (LTS), .NET 9 (STS), and .NET 10 -->
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- Strict Compiler Hygiene & Quality Gate -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!-- Native AOT & Trimming Support -->
		<IsAotCompatible>true</IsAotCompatible>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<IsTrimmable>true</IsTrimmable>

		<!-- NuGet Package Identity & Metadata -->
		<PackageId>BankSharp.FluentValidation</PackageId>
		<Version>1.0.0</Version>
		<Authors>EhsanChegeni</Authors>
		<Company>EhsanChegeni</Company>
		<Title>BankSharp.FluentValidation - FluentValidation Extensions for BankSharp</Title>
		<Description>FluentValidation extensions for BankSharp. Provides fluent rule builders (.MustBeValidIban()) for seamless, high-performance IBAN validation with custom error messages and ISO-13616 compliance.</Description>
		<PackageTags>iban;banking;fintech;fluentvalidation;validation;rules;validator;iso13616;dotnet8;dotnet9;dotnet10</PackageTags>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageProjectUrl>https://github.com/ehsanch701/BankSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ehsanch701/BankSharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>Initial 1.0.0 release providing fluent extension methods for IBAN validation with FluentValidation.</PackageReleaseNotes>

		<!-- Documentation & SourceLink Debugging Experience (Embedded PDB for Seamless Step-Through) -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DebugType>portable</DebugType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>

		<!-- Symbol Package (.snupkg) Generation for NuGet Debugging Experience -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- Deterministic CI Builds for GitHub Actions -->
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- NuGet Package Assets -->
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<!-- Enable Source Link for reproducible builds and source stepping in debuggers -->
	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
	</ItemGroup>

	<!-- FluentValidation Core Dependency -->
	<ItemGroup>
		<PackageReference Include="FluentValidation" Version="12.1.1" />
	</ItemGroup>

	<!-- Core BankSharp Reference (Packaged as a package dependency) -->
	<ItemGroup>
		<ProjectReference Include="..\BankSharp\BankSharp.csproj" />
	</ItemGroup>

	<!-- NuGet Assets Packaging (Clean, Safe & Deterministic Relative Paths) -->
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
