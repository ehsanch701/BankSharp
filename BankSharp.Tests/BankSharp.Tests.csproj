<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Multi-targeting test runs across LTS and modern .NET runtimes -->
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- Strict compiler quality gate while testing -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!-- Test project specific flags (Disable NuGet packaging) -->
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>

		<!-- Suppress missing XML documentation warnings for test cases (CS1591) -->
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<!-- Core test execution harness & runner dependencies -->
	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector" Version="6.0.4">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="FluentValidation" Version="12.1.1" />
	</ItemGroup>

	<!-- .NET 8.0: EF Core In-Memory 8 and classic Swashbuckle -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.13" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.6.2" />
	</ItemGroup>

	<!-- .NET 9.0: EF Core In-Memory 9 and Microsoft OpenAPI v1 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.2" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.2" />
	</ItemGroup>

	<!-- .NET 10.0: EF Core In-Memory 10 and Microsoft OpenAPI v2 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.*" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
	</ItemGroup>

	<!-- References covering all projects within the BankSharp ecosystem -->
	<ItemGroup>
		<ProjectReference Include="..\BankSharp\BankSharp.csproj" />
		<ProjectReference Include="..\BankSharp.DependencyInjection\BankSharp.DependencyInjection.csproj" />
		<!-- Adjust relative directory path if your folder is named BankSharp.FluentValidation -->
		<ProjectReference Include="..\FluentValidation\BankSharp.FluentValidation.csproj" />
		<ProjectReference Include="..\BankSharp.EntityFrameworkCore\BankSharp.EntityFrameworkCore.csproj" />
		<ProjectReference Include="..\BankSharp.OpenApi\BankSharp.OpenApi.csproj" />
	</ItemGroup>

	<!-- Global test namespaces for clean test classes -->
	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
