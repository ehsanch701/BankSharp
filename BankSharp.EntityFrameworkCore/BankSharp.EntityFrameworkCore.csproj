<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Target Frameworks: Multi-targeting .NET 8 (LTS), .NET 9 (STS), and .NET 10 -->
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- Strict Compiler Hygiene & Quality Gate -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!-- NuGet Package Identity & Metadata -->
		<PackageId>BankSharp.EntityFrameworkCore</PackageId>
		<Version>1.0.0</Version>
		<Authors>EhsanChegeni</Authors>
		<Company>EhsanChegeni</Company>
		<Title>BankSharp.EntityFrameworkCore - EF Core Support for BankSharp</Title>
		<Description>Entity Framework Core integration for BankSharp. Provides strongly-typed ValueConverters, ModelBuilder extensions, and transparent database persistence for IBANs.</Description>
		<PackageTags>iban;banking;fintech;entity-framework-core;efcore;ef;valueconverter;modelbuilder;orm;database;dotnet8;dotnet9;dotnet10</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/ehsanch701/BankSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ehsanch701/BankSharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>Initial 1.0.0 release providing IbanValueConverter and ModelBuilder configuration extensions for EF Core.</PackageReleaseNotes>

		<!-- Documentation & Symbols Packaging (SourceLink & Debugging Experience) -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>

		<!-- Deterministic CI Builds for GitHub Actions -->
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- NuGet Package Assets -->
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<!-- Enable Source Link for reproducible builds and source stepping in debuggers -->
	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
	</ItemGroup>

	<!-- Target-specific EF Core dependencies -->
	<ItemGroup>
		<!-- Use EF Core 8.x for .NET 8 target -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" Condition="'$(TargetFramework)' == 'net8.0'" />

		<!-- Use EF Core 9.x for .NET 9 target -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.2" Condition="'$(TargetFramework)' == 'net9.0'" />

		<!-- Use EF Core 10.x for .NET 10 target -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0-preview.1.25081.1" Condition="'$(TargetFramework)' == 'net10.0'" />
	</ItemGroup>

	<!-- Project reference: dotnet pack will automatically transform this into a NuGet package dependency -->
	<ItemGroup>
		<ProjectReference Include="..\BankSharp\BankSharp.csproj" />
	</ItemGroup>

	<!-- NuGet Assets Packaging (Clean, Safe & Deterministic Relative Paths) -->
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
