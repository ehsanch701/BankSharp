<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Multi-targeting .NET 8 (LTS), .NET 9 (STS), and .NET 10 for broad compatibility -->
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- Strict Compiler Hygiene & Quality Gate -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!-- NuGet Package Identity & Metadata -->
		<PackageId>BankSharp.EntityFrameworkCore</PackageId>
		<Version>1.0.0</Version>
		<Authors>EhsanChegeni</Authors>
		<Company>EhsanChegeni</Company>
		<Title>BankSharp.EntityFrameworkCore - EF Core Support for BankSharp</Title>
		<Description>Entity Framework Core integration for BankSharp. Provides strongly-typed ValueConverters, ModelBuilder extensions, and transparent database persistence for IBANs.</Description>
		<PackageTags>iban;banking;fintech;entity-framework-core;efcore;ef;valueconverter;modelbuilder;orm;database;dotnet8;dotnet9;dotnet10</PackageTags>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageProjectUrl>https://github.com/ehsanch701/BankSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ehsanch701/BankSharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>Initial 1.0.0 release providing IbanValueConverter and ModelBuilder configuration extensions for EF Core.</PackageReleaseNotes>

		<!-- Documentation & SourceLink Debugging Experience (Embedded PDB for Seamless Step-Through) -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DebugType>embedded</DebugType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>

		<!-- Deterministic CI Builds for GitHub Actions -->
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- Package Assets -->
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<!-- Enable Source Link for reproducible builds and source stepping in debuggers -->
	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
	</ItemGroup>

	<!-- EF Core dependencies: Using Stable version 9.0.2 for all targets to avoid NU5104 error -->
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.2" />
	</ItemGroup>

	<!-- Project reference for core functionality -->
	<ItemGroup>
		<ProjectReference Include="..\BankSharp\BankSharp.csproj" />
	</ItemGroup>

	<!-- NuGet Assets Packaging (Clean, Safe & Deterministic Relative Paths) -->
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
