<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Target Frameworks: Multi-targeting modern LTS and STS .NET versions -->
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- Native AOT & Trimming Compatibility (Guarantees zero-reflection and full trim safety) -->
		<IsAotCompatible>true</IsAotCompatible>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<IsTrimmable>true</IsTrimmable>

		<!-- NuGet Package Identity & Metadata -->
		<PackageId>BankSharp</PackageId>
		<Version>1.0.0</Version>
		<Authors>EhsanChegeni</Authors>
		<Company>EhsanChegeni</Company>
		<Title>BankSharp - High-Performance Banking &amp; IBAN Library for .NET</Title>
		<Description>BankSharp is a zero-allocation, ultra-high-performance, Native AOT-compatible banking library designed for validating, parsing, and formatting IBANs (International Bank Account Numbers) with full ISO 13616 and Iranian Sheba support.</Description>
		<PackageTags>iban;banking;fintech;finance;mod97;zero-allocation;aot;performance;csharp;dotnet8;dotnet9;dotnet10;sheba</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/ehsanch701/BankSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ehsanch701/BankSharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>Initial 1.0.0 release featuring zero-allocation IBAN validation, formatting, parsing, Native AOT support, and multi-targeting for .NET 8, 9, and 10.</PackageReleaseNotes>

		<!-- Documentation & Symbols Packaging (SourceLink & Debugging Experience) -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>

		<!-- Deterministic CI Builds for GitHub Actions -->
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- NuGet Package Assets -->
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<!-- Source Link for Step-Through Debugging from NuGet -->
	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
	</ItemGroup>

	<!-- Internal Visibility across Solution projects for testing and internal component interop -->
	<ItemGroup>
		<InternalsVisibleTo Include="BankSharp.Tests" />
		<InternalsVisibleTo Include="BankSharp.Benchmarks" />
		<InternalsVisibleTo Include="BankSharp.DependencyInjection" />
		<InternalsVisibleTo Include="BankSharp.EntityFrameworkCore" />
		<InternalsVisibleTo Include="BankSharp.OpenApi" />
	</ItemGroup>

	<!-- Pack README.md gracefully from root or project directory -->
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" Visible="false" />
		<None Include="..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\README.md') and !Exists('..\..\README.md')" Visible="false" />
		<None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md') and !Exists('..\README.md') and !Exists('..\..\README.md')" Visible="false" />
	</ItemGroup>

	<!-- Pack icon.png gracefully from root or project directory -->
	<ItemGroup>
		<None Include="..\..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\..\icon.png')" Visible="false" />
		<None Include="..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\icon.png') and !Exists('..\..\icon.png')" Visible="false" />
		<None Include="icon.png" Pack="true" PackagePath="\" Condition="Exists('icon.png') and !Exists('..\icon.png') and !Exists('..\..\icon.png')" Visible="false" />
	</ItemGroup>

</Project>
