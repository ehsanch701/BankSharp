<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Target Frameworks: Multi-targeting modern LTS and STS .NET versions -->
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- Strict Compiler Hygiene & Quality Gate -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!-- Native AOT & Trimming Compatibility (Guarantees zero-reflection and full trim safety) -->
		<IsAotCompatible>true</IsAotCompatible>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<IsTrimmable>true</IsTrimmable>

		<!-- NuGet Package Identity & Metadata -->
		<PackageId>BankSharp</PackageId>
		<Version>1.0.0</Version>
		<Authors>EhsanChegeni</Authors>
		<Company>EhsanChegeni</Company>
		<Title>BankSharp - High-Performance Banking &amp; IBAN Library for .NET</Title>
		<Description>BankSharp is a zero-allocation, ultra-high-performance, Native AOT-compatible banking library designed for validating, parsing, and formatting IBANs (International Bank Account Numbers) with full ISO 13616 and Iranian Sheba support.</Description>
		<PackageTags>iban;banking;fintech;finance;mod97;zero-allocation;aot;performance;csharp;dotnet8;dotnet9;dotnet10;sheba</PackageTags>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageProjectUrl>https://github.com/ehsanch701/BankSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ehsanch701/BankSharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>Initial 1.0.0 release featuring zero-allocation IBAN validation, formatting, parsing, Native AOT support, and multi-targeting for .NET 8, 9, and 10.</PackageReleaseNotes>

		<!-- Documentation & SourceLink Debugging Experience (Embedded PDB for Seamless Step-Through) -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DebugType>portable</DebugType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>

		<!-- Symbol Package (.snupkg) Generation for NuGet Debugging Experience -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- Deterministic CI Builds for GitHub Actions -->
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- NuGet Package Assets -->
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<!-- Source Link for Step-Through Debugging from NuGet -->
	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
	</ItemGroup>

	<!-- Internal Visibility across Solution projects for testing and internal component interop -->
	<ItemGroup>
		<InternalsVisibleTo Include="BankSharp.Tests" />
		<InternalsVisibleTo Include="BankSharp.Benchmarks" />
		<InternalsVisibleTo Include="BankSharp.DependencyInjection" />
		<InternalsVisibleTo Include="BankSharp.EntityFrameworkCore" />
		<InternalsVisibleTo Include="BankSharp.OpenApi" />
	</ItemGroup>

	<!-- NuGet Assets Packaging (Clean, Safe & Deterministic Relative Paths) -->
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
